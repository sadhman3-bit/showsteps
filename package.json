{
  "name": "trailmark",
  "private": true,
  "version": "1.0.0",
  "description": "Local-first how-to guide recorder",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "pnpm -r run test",
    "e2e": "node scripts/playwright.mjs test --project=chromium --project=replay",
    "e2e:desktop": "node scripts/playwright.mjs test --project=desktop --workers=1",
    "demo": "node fixtures/demo-app/server.mjs",
    "setup:browsers": "node scripts/playwright.mjs install chromium",
    "snapshot:demo": "node scripts/snapshot-demo.mjs",
    "make:icons": "node scripts/make-icons.mjs",
    "make:samples": "node scripts/make-samples.mjs",
    "store:images": "node scripts/playwright.mjs test --project=store",
    "release": "pnpm build && pnpm --filter @trailmark/desktop dist && node scripts/release.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@tesseract.js-data/eng": "1.0.0",
    "@trailmark/core": "workspace:*",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "fflate": "^0.8.3",
    "globals": "^17.13.0",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^6.4.299",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}

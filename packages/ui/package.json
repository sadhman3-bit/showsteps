{
  "name": "@trailmark/ui",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens.css": "./src/tokens.css",
    "./strings": {
      "types": "./dist/strings.d.ts",
      "import": "./dist/strings.js"
    },
    "./app.css": "./src/app.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@trailmark/core": "workspace:*",
    "dompurify": "^3.4.16",
    "preact": "^11.0.1",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "preact-render-to-string": "^6.8.0"
  }

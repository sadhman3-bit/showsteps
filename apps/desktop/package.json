{
  "name": "@showsteps/desktop",
  "productName": "ShowSteps",
  "version": "1.1.0",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "description": "ShowSteps for Windows: record desktop and web steps, edit, export and guide.",
  "type": "module",
  "main": "dist/main/index.cjs",
  "scripts": {
    "build:native": "node scripts/build-native.mjs",
    "build": "node scripts/build-native.mjs && vite build --config vite.main.config.ts && vite build --config vite.preload.config.ts && node ../../scripts/copy-ocr.mjs src/renderer/public/ocr && vite build",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dist": "pnpm run build && electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@showsteps/core": "workspace:*",
    "@showsteps/ui": "workspace:*",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "preact": "^11.0.1",
    "vite": "^8.3.4",
    "zod": "^4.6.5"
  },
  "build": {
    "appId": "app.showsteps.desktop",
    "productName": "ShowSteps",
    "copyright": "Copyright (c) 2026 Sadhman. Free for non-commercial use (PolyForm Noncommercial 1.0.0).",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/bin",
        "to": "bin",
        "filter": [
          "*.exe"
        ]
      },
      {
        "from": "resources",
        "to": ".",
        "filter": [
          "icon.png",
          "tray*.png"
        ]
      }
    ],
    "asar": true,
    "win": {
      "target": "nsis",
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh",
      "artifactName": "ShowSteps-Setup-${version}.${ext}"
    }
  }
}

{
  "name": "@trailmark/desktop",
  "productName": "Trailmark",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Trailmark for Windows: record desktop and web steps, edit, export and guide.",
  "type": "module",
  "main": "dist/main/index.cjs",
  "scripts": {
    "build:native": "node scripts/build-native.mjs",
    "build": "node scripts/build-native.mjs && vite build --config vite.main.config.ts && vite build --config vite.preload.config.ts && vite build",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dist": "pnpm run build && electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@trailmark/core": "workspace:*",
    "@trailmark/ui": "workspace:*",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "preact": "^11.0.1",
    "vite": "^8.3.4",
    "zod": "^4.6.5"
  },
  "build": {
    "appId": "app.trailmark.desktop",
    "productName": "Trailmark",
    "copyright": "MIT licence",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/bin",
        "to": "bin",
        "filter": [
          "*.exe"
        ]
      },
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      }
    ],
    "asar": true,
    "win": {
      "target": "nsis",
      "icon": "resources/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh",
      "artifactName": "Trailmark-Setup-${version}.${ext}"
    }
  }
}
